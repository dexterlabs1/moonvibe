{
  "_comment": [
    "Shot definitions for offscreen review captures. One process per shot:",
    "  MOONVIBE_SHOOT=<name> MOONVIBE_SHOOT_OUT=<dir> ./moonvibe",
    "tools/shoot/review.sh runs all of them, then the design linter over the dumps.",
    "",
    "  view      what main.qml starts on (default qrc:/gui/PcView.qml)",
    "  fixtures  default (three hosts) | single | none",
    "  steps     key: a QKeySequence string, sent to the window",
    "            eval: QML evaluated in main.qml's scope, so ids like stackView work",
    "            click: [x, y] in window coordinates",
    "            waitMs: pause after this step (default 150)",
    "  settleMs  pause before the first step and before the grab",
    "",
    "Adding a shot needs no rebuild. Prefer eval over long key sequences: a shot",
    "that navigates by pressing Down eleven times breaks the day a row is added."
  ],

  "shots": {
    "hosts": {
      "view": "qrc:/gui/PcView.qml",
      "fixtures": "default"
    },

    "hosts-empty": {
      "view": "qrc:/gui/PcView.qml",
      "fixtures": "none",
      "settleMs": 900
    },

    "hosts-focused": {
      "view": "qrc:/gui/PcView.qml",
      "fixtures": "default",
      "steps": [
        { "key": "Down", "waitMs": 250 }
      ]
    },

    "host-menu": {
      "view": "qrc:/gui/PcView.qml",
      "fixtures": "default",
      "steps": [
        { "key": "Down", "waitMs": 250 },
        { "key": "Menu", "waitMs": 400 }
      ]
    },

    "library": {
      "view": "qrc:/gui/PcView.qml",
      "fixtures": "single",
      "steps": [
        {
          "eval": "var c = Qt.createComponent('qrc:/gui/AppView.qml'); stackView.push(c.createObject(stackView, {'computerIndex': 0, 'objectName': 'TOWER'}))",
          "waitMs": 900
        }
      ],
      "settleMs": 700
    },

    "library-focused": {
      "view": "qrc:/gui/PcView.qml",
      "fixtures": "single",
      "steps": [
        {
          "eval": "var c = Qt.createComponent('qrc:/gui/AppView.qml'); stackView.push(c.createObject(stackView, {'computerIndex': 0, 'objectName': 'TOWER'}))",
          "waitMs": 900
        },
        { "key": "Right", "waitMs": 300 }
      ],
      "settleMs": 700
    },

    "settings": {
      "view": "qrc:/gui/PcView.qml",
      "fixtures": "default",
      "steps": [
        { "eval": "settingsButton.clicked()", "waitMs": 900 }
      ],
      "settleMs": 700
    },

    "settings-audio": {
      "_note": "D-pad Down on the rail moves the selection to Audio and swaps the pane live.",
      "view": "qrc:/gui/PcView.qml",
      "fixtures": "default",
      "steps": [
        { "eval": "settingsButton.clicked()", "waitMs": 900 },
        { "key": "Down", "waitMs": 300 }
      ],
      "settleMs": 700
    },

    "settings-pane": {
      "_note": "Right enters the Display pane (focus on the first control); Tab travels to the next.",
      "view": "qrc:/gui/PcView.qml",
      "fixtures": "default",
      "steps": [
        { "eval": "settingsButton.clicked()", "waitMs": 900 },
        { "key": "Right", "waitMs": 250 },
        { "key": "Tab", "waitMs": 300 }
      ],
      "settleMs": 700
    },

    "settings-advanced": {
      "_note": "Display category scrolled down: the folded-in ADVANCED SETTINGS card sits below the DISPLAY card and is reachable.",
      "view": "qrc:/gui/PcView.qml",
      "fixtures": "default",
      "steps": [
        { "eval": "settingsButton.clicked()", "waitMs": 900 },
        { "eval": "stackView.currentItem.scrollPaneToBottom()", "waitMs": 400 }
      ],
      "settleMs": 700
    },

    "settings-input": {
      "_note": "Input category (D-pad Down x4): the INPUT card, then the folded-in GAMEPAD SETTINGS card below it.",
      "view": "qrc:/gui/PcView.qml",
      "fixtures": "default",
      "steps": [
        { "eval": "settingsButton.clicked()", "waitMs": 900 },
        { "key": "Down", "waitMs": 150 },
        { "key": "Down", "waitMs": 150 },
        { "key": "Down", "waitMs": 150 },
        { "key": "Down", "waitMs": 300 }
      ],
      "settleMs": 700
    },

    "settings-desktop": {
      "_note": "Desktop present, not Gaming Mode: the desktop-only rows (e.g. Display mode) SHOW.",
      "view": "qrc:/gui/PcView.qml",
      "fixtures": "default",
      "env": { "HAS_DESKTOP_ENVIRONMENT": "1" },
      "steps": [
        { "eval": "settingsButton.clicked()", "waitMs": 900 }
      ],
      "settleMs": 700
    },

    "settings-gaming": {
      "_note": "Desktop present but Gaming Mode forced on: the same desktop-only rows are ABSENT.",
      "view": "qrc:/gui/PcView.qml",
      "fixtures": "default",
      "env": { "HAS_DESKTOP_ENVIRONMENT": "1", "MOONVIBE_GAMING": "1" },
      "steps": [
        { "eval": "settingsButton.clicked()", "waitMs": 900 }
      ],
      "settleMs": 700
    },

    "add-pc": {
      "view": "qrc:/gui/PcView.qml",
      "fixtures": "default",
      "steps": [
        { "eval": "addPcDialog.open()", "waitMs": 500 }
      ]
    },

    "quit-confirm": {
      "view": "qrc:/gui/PcView.qml",
      "fixtures": "single",
      "steps": [
        { "eval": "quitConfirmationDialog.open()", "waitMs": 500 }
      ]
    }
  }
}
